#!/usr/bin/env bash
# chronicle-write — Chronicle plugin dispatcher binary.
# Usage: chronicle-write <subcommand> [args...]
# Subcommands: session-start, stop-session, lesson-candidate, due
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$(cd "$SCRIPT_DIR/../scripts" && pwd)"

subcommand="${1:-}"

case "$subcommand" in
  session-start)
    bash "$SCRIPTS_DIR/first-run-init.sh"
    # Write session ID if not already set for this session
    SLUG="${CHRONICLE_PROJECT_SLUG:-$(basename "${CLAUDE_PROJECT_DIR:-$PWD}")}"
    DATA_DIR="${CLAUDE_PLUGIN_DATA:-${HOME}/.claude/plugin-data}"
    SESSION_FILE="$DATA_DIR/$SLUG/current-session-id"
    if [[ ! -f "$SESSION_FILE" ]]; then
      SESSION_ID="$(date +%s)-$(openssl rand -hex 4)"
      echo "$SESSION_ID" > "$SESSION_FILE"
      echo "chronicle: session started: $SESSION_ID" >&2
    else
      echo "chronicle: session already active: $(cat "$SESSION_FILE")" >&2
    fi
    bash "$SCRIPTS_DIR/check-due.sh"
    ;;

  stop-session)
    bash "$SCRIPTS_DIR/stop-session.sh"
    ;;

  lesson-candidate)
    bash "$SCRIPTS_DIR/lesson-candidate.sh"
    ;;

  due)
    bash "$SCRIPTS_DIR/check-due.sh"
    ;;

  # ── Extension point: future subcommands — add cases below this line ──────
  archive)
    LIB="$SCRIPT_DIR/../lib/chronicle-vault.js"
    DRY_RUN_FLAG="${2:-}"
    DRY_RUN="false"
    [[ "$DRY_RUN_FLAG" == "--dry-run" ]] && DRY_RUN="true"
    if command -v bun &>/dev/null; then
      bun --eval "
        import { archiveNotes } from '$LIB';
        const r = await archiveNotes({ olderThanDays: 180, dryRun: $DRY_RUN });
        if ($DRY_RUN) {
          process.stderr.write('chronicle archive: dry-run -- no files moved\n');
        } else {
          process.stderr.write('chronicle archive: archived ' + r.archived + ' note(s)\n');
        }
      " 2>&1 || true
    fi
    ;;

  prune)
    LIB="$SCRIPT_DIR/../lib/chronicle-vault.js"
    DRY_RUN_FLAG="${2:-}"
    DRY_RUN="false"
    [[ "$DRY_RUN_FLAG" == "--dry-run" ]] && DRY_RUN="true"
    if command -v bun &>/dev/null; then
      bun --eval "
        import { pruneFixtures } from '$LIB';
        const r = pruneFixtures({ dryRun: $DRY_RUN });
        if ($DRY_RUN) {
          process.stderr.write('chronicle prune: dry-run -- ' + r.count + ' would be removed\n');
        } else {
          process.stderr.write('chronicle prune: removed ' + r.count + ' note(s)\n');
        }
      " 2>&1 || true
    fi
    ;;

  import)
    bash "$SCRIPTS_DIR/migrate-from-advisor.sh" "${@:2}"
    ;;
  # ── End extension point ───────────────────────────────────────────────────

  "")
    echo "Usage: chronicle-write <subcommand> [args...]" >&2
    echo "Subcommands: session-start, stop-session, lesson-candidate, due" >&2
    exit 1
    ;;
  *)
    echo "chronicle-write: unknown subcommand: $subcommand" >&2
    exit 1
    ;;
esac
